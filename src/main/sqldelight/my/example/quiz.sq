CREATE TABLE quiz (
id INTEGER PRIMARY KEY AUTOINCREMENT,
quest INTEGER DEFAULT NULL,
text TEXT NOT NULL,
right INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX quiz_quest ON quiz(quest);

