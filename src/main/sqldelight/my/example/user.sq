all:
SELECT * FROM user;

user:
SELECT * FROM user WHERE id=?;

insert {
INSERT INTO user(name) VALUES (?);
SELECT last_insert_rowid();
}

add:
INSERT INTO user VALUES ?;

update:
UPDATE user SET name=?, points=? WHERE id=?;

delete:
DELETE FROM user WHERE id=?;