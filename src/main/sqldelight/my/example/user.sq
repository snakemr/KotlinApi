CREATE TABLE user (
id INTEGER PRIMARY KEY AUTOINCREMENT,
name TEXT NOT NULL,
mail TEXT NOT NULL,
pass TEXT NOT NULL,
session TEXT DEFAULT NULL,
otp INTEGER DEFAULT 0
);

CREATE UNIQUE INDEX user_mail ON user(mail);

INSERT INTO user (name, mail, pass) VALUES ('Иван Петров', 'ivan@mail.ru', '123');

all:
SELECT * FROM user;

get:
SELECT * FROM user WHERE id=?;

user:
SELECT * FROM user WHERE mail=?;

insert {
INSERT INTO user(name, mail, pass) VALUES (?, ?, ?);
SELECT last_insert_rowid();
}

add:
INSERT INTO user VALUES ?;

session:
UPDATE user SET otp=NULL, session=? WHERE mail=?;

otp:
UPDATE user SET otp=? WHERE mail=?;

logout:
UPDATE user SET otp=NULL, session=NULL WHERE id=?;