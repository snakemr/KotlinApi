CREATE TABLE user (
id INTEGER PRIMARY KEY AUTOINCREMENT,
name TEXT NOT NULL,
email TEXT NOT NULL,
phone TEXT NOT NULL,
pass TEXT NOT NULL,
balance REAL NOT NULL DEFAULT 100
);

CREATE UNIQUE INDEX user_email ON user(email);
CREATE INDEX user_name ON user(name);

INSERT INTO user VALUES (1, "Darth Vendor", "darth@vendor.com", "77777777777", "good_password", 1000000);

all:
SELECT * FROM user;

insert:
INSERT INTO user(name, email, phone, pass) VALUES (?,?,?,?);

login:
SELECT * FROM user WHERE email=?;

setpassword:
UPDATE user SET pass=? WHERE email=?;

charge:
UPDATE user SET balance=balance-? WHERE id=?;