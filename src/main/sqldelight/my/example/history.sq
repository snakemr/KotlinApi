CREATE TABLE history (
id INTEGER PRIMARY KEY AUTOINCREMENT,
user INTEGER NOT NULL,
description TEXT NOT NULL
);

CREATE INDEX user_mail ON user(mail);

INSERT INTO user (name, mail, pass) VALUES ('Иван Петров', 'ivan@mail.ru', '123');

all:
SELECT * FROM user;

user:
SELECT * FROM user WHERE mail=?;

insert {
INSERT INTO user(name, mail, pass) VALUES (?, ?, ?);
SELECT last_insert_rowid();
}

add:
INSERT INTO user VALUES ?;

session:
UPDATE user SET otp=NULL, session=? WHERE mail=?;

otp:
UPDATE user SET otp=? WHERE mail=?;

logout:
UPDATE user SET otp=NULL, session=NULL WHERE mail=?;