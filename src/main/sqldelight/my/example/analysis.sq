(1, "Сертификат вакцинации от COVID-2019", 1739882259);

all:
SELECT description, datetime(date, 'unixepoch') FROM analysis WHERE user=?;

insert {
INSERT INTO analysis(user, description, date) VALUES (?, ?, strftime('%s', 'now'));
SELECT last_insert_rowid();
}
