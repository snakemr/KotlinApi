CREATE TABLE logon (
email TEXT PRIMARY KEY,
user INTEGER NOT NULL,
token TEXT NOT NULL
);

CREATE UNIQUE INDEX logon_user ON logon(user);
CREATE UNIQUE INDEX logon_token ON logon(token);

login {
DELETE FROM logon WHERE email=:email;
INSERT INTO logon(email, user, token) VALUES (:email,:id,:token);
}

logout:
DELETE FROM logon WHERE token=?;

user:
SELECT user FROM logon WHERE token=?;

profile:
SELECT user.* FROM logon LEFT JOIN user ON logon.user=user.id WHERE token=?;

history:
SELECT history.* FROM logon LEFT JOIN history ON logon.user=history.user WHERE token=? ORDER BY date;